# Public-key-only service. Keep the private signing key with the chat backend.
ISLANDS_DATABASE=/srv/tescord/plugins/islands/data/islands.sqlite3
ISLANDS_GRANT_PUBLIC_KEY_PATH=/etc/kvachat/islands-grant-public.pem
ISLANDS_ALLOWED_ORIGINS=https://kvachat.ru,https://localhost
ISLANDS_ALLOWED_HOSTS=kvachat.ru,127.0.0.1,localhost
