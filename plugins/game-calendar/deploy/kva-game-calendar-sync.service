[Unit]
Description=Refresh KvaChat game calendar from public source
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tescord
Group=tescord
WorkingDirectory=/srv/tescord/plugins/game-calendar/current
Environment=KVA_CALENDAR_DB=/srv/tescord/plugins/game-calendar/data/calendar.sqlite3
EnvironmentFile=-/etc/kvachat/game-calendar.env
ExecStart=/srv/tescord/plugins/game-calendar/venv/bin/python -m game_calendar.sync
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tescord/plugins/game-calendar/data
UMask=0027
