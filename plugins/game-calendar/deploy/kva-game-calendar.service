[Unit]
Description=KvaChat independent game calendar
After=network.target

[Service]
User=tescord
Group=tescord
WorkingDirectory=/srv/tescord/plugins/game-calendar/current
Environment=KVA_CALENDAR_DB=/srv/tescord/plugins/game-calendar/data/calendar.sqlite3
ExecStart=/srv/tescord/plugins/game-calendar/venv/bin/uvicorn game_calendar.app:app --host 127.0.0.1 --port 8012 --workers 1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tescord/plugins/game-calendar/data
UMask=0027

[Install]
WantedBy=multi-user.target
