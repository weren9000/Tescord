TESCORD_APP_NAME=KVA Chat API
TESCORD_API_PREFIX=/api
TESCORD_ENVIRONMENT=production
TESCORD_DEBUG=false
TESCORD_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/tescord
TESCORD_CORS_ORIGINS=["https://kvachat.ru"]
TESCORD_ALLOWED_HOSTS=["kvachat.ru","127.0.0.1","localhost"]
TESCORD_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
TESCORD_ACCESS_TOKEN_EXPIRE_MINUTES=10080
TESCORD_SEED_DEMO_DATA=false
TESCORD_RATE_LIMITS_ENABLED=true
TESCORD_REDIS_URL=redis://127.0.0.1:6379/1
TESCORD_UPLOADS_DIR=/srv/tescord/shared/storage/uploads
TESCORD_LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
TESCORD_MAX_MESSAGE_UPLOAD_BYTES=524288000
TESCORD_USER_UPLOAD_QUOTA_BYTES=5368709120
TESCORD_PUSH_VAPID_PUBLIC_KEY=
TESCORD_PUSH_VAPID_PRIVATE_KEY_PATH=
TESCORD_PUSH_VAPID_SUBJECT=mailto:admin@example.com
